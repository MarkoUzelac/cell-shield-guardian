# ---------------------------------------------------------------------------
# Cell Shield Guardian — environment template
# Copy to `.env` for local development, or `.env.production` for builds.
# Only variables prefixed with VITE_ are inlined into the client bundle, so
# ONLY put publicly shareable values here. Never commit real secrets.
# ---------------------------------------------------------------------------

# PUBLIC — canonical production origin used for absolute links/metadata.
VITE_SITE_URL=https://markouzelacuzy.com

# PUBLIC — set to "false" to hide the simulated /demo and /tactical routes.
VITE_ENABLE_SIMULATION_ROUTES=true

# NOTE: this app is fully client-side. There is no server component, so there
# are no API secrets, database credentials or private keys to configure.
# If you later add a backend, keep those values server-side (no VITE_ prefix).
